<Window x:Class="LibertyRoute.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LibertyRoute" Height="430" Width="360"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="LibertyRoute" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Text="Desktop VPN" Margin="0,4,0,0" Opacity="0.65" HorizontalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <Ellipse Width="16" Height="16" Fill="Gray" HorizontalAlignment="Center"/>
            <TextBlock x:Name="StateText" Text="Disconnected" FontSize="20" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,12,0,28"/>
            <Button x:Name="ConnectButton" Content="CONNECT" Width="210" Height="54"
                    FontSize="16" FontWeight="SemiBold" Click="ConnectButton_Click"/>
            <TextBlock x:Name="DetailText" Text="Server: Not configured" Margin="0,22,0,0"
                       TextAlignment="Center" TextWrapping="Wrap" Opacity="0.75"/>
        </StackPanel>

        <TextBlock Grid.Row="2"
                   Text="Phase 1 • Safe rollback foundation"
                   HorizontalAlignment="Center" Opacity="0.55"/>
    </Grid>
</Window>
